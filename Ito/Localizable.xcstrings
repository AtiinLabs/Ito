    "%@ is also removed from your lists. Reading history and progress are kept." : {
      "comment" : "Confirm removing a series from the Library. The placeholder is the series title."
    },
    "%@ is also removed from your lists. Reading history and progress are kept. Remove from Library keeps its %lld downloaded chapters." : {
      "comment" : "Confirm removing a series that has saved chapters. The dialog also has a Remove Library and Downloads button that deletes them, so the keeping is tied to the Remove from Library button. The first placeholder is the series title, the second the number of saved chapters.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ is also removed from your lists. Reading history and progress are kept. Remove from Library keeps its %2$lld downloaded chapter."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ is also removed from your lists. Reading history and progress are kept. Remove from Library keeps its %2$lld downloaded chapters."
                }
              }
            }
          }
        }
      }
    },
    "%@ is also removed from your lists. Reading history and progress are kept. Remove from Library keeps its downloads." : {
      "comment" : "Confirm removing a series whose downloads are damaged or still queued. The dialog also has a Remove Library and Downloads button that deletes them, so the keeping is tied to the Remove from Library button. The placeholder is the series title."
    },
