// The app version for every target. See docs/RELEASING.md.
//
// MARKETING_VERSION is the version main would be released as: numeric X.Y.Z only
// (it becomes CFBundleShortVersionString). After a release, bump the patch;
// a feature bumps the minor. See docs/RELEASING.md.
MARKETING_VERSION = 1.1.1

// CI overrides this with the commit count of the built commit
// (`git rev-list --count HEAD`). Local builds use 1.
CURRENT_PROJECT_VERSION = 1
