		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$@ has %2$lld new chapter.</string>
			<key>other</key>
			<string>%1$@ has %2$lld new chapters.</string>
		</dict>
